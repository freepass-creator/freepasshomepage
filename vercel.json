{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path((?!(?:about|about[.]html|index[.]html|robots[.]txt|sitemap[.]xml)$|(?:assets|css|js)/).+)",
      "destination": "https://freepasserp.com/:path",
      "permanent": false
    }
  ]
}
