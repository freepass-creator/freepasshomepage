{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "meta": {
    "brand": "FreePass Mobility",
    "version": "0.1.0-hold.1",
    "status": "HOLD",
    "note": "Observed candidate values, not an approved brand release."
  },
  "color": {
    "brand": {
      "navy": { "$type": "color", "$value": "#1B2A4A", "$description": "Observed in both candidate families." },
      "steel": { "$type": "color", "$value": "#7F93B3", "$description": "Observed in the mobility portion of the wordmark family." },
      "white": { "$type": "color", "$value": "#FFFFFF", "$description": "Observed check color." },
      "surface": { "$type": "color", "$value": "#F7F8FA", "$description": "CI Center neutral preview surface; not a logo color." }
    }
  },
  "font": {
    "wordmarkCandidate": {
      "$type": "fontFamily",
      "$value": ["Exo 2", "Pretendard", "Arial", "sans-serif"],
      "$description": "Font dependency found in the candidate SVG; never use this token to redraw the logo."
    },
    "interface": {
      "$type": "fontFamily",
      "$value": ["Pretendard", "Arial", "sans-serif"]
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } }
  }
}
